rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isLoggedIn() {
      return request.auth != null;
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function getUserRole(uid) {
      return getUserData(uid).role;
    }
    
    function isAdmin() {
      return isLoggedIn() && getUserRole(request.auth.uid) == 'admin';
    }
    
    function isDoctor() {
      return isLoggedIn() && getUserRole(request.auth.uid) == 'doctor';
    }
    
    function isClient() {
      return isLoggedIn() && getUserRole(request.auth.uid) == 'client';
    }

    // --- Users Collection ---
    match /users/{uid} {
      // Anyone logged in can read user profiles (needed for clients to read doctor names, admins to list users)
      allow read: if isLoggedIn();
      
      // Creating profiles
      allow create: if (isLoggedIn() && request.auth.uid == uid && request.resource.data.role == 'client') // Clients can register themselves
                    || isAdmin(); // Admins can register doctors/others
                    
      // Updating profiles
      allow update: if isLoggedIn() 
                    && (
                      isAdmin() // Admin can update anyone
                      || (request.auth.uid == uid && request.resource.data.role == resource.data.role) // Clients cannot alter their own role
                    );
                    
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // --- Inquiries Collection ---
    match /inquiries/{inquiryId} {
      // Clients can read their own, assigned doctors can read theirs, admins can read all
      allow read: if isLoggedIn() 
                    && (
                      isAdmin() 
                      || (isDoctor() && resource.data.doctorId == request.auth.uid)
                      || (isClient() && resource.data.clientId == request.auth.uid)
                    );
                    
      // Clients can create new pending inquiries under their own UID
      allow create: if isClient() 
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending';
                    
      // Updating inquiries
      allow update: if isLoggedIn()
                    && (
                      isAdmin() // Admins can assign doctors, change statuses
                      || (
                        isDoctor() 
                        && resource.data.doctorId == request.auth.uid // Must be assigned to this doctor
                        && request.resource.data.status == 'answered' // Doctor can only mark as answered
                        && request.resource.data.doctorId == resource.data.doctorId // Cannot change assigned doctor
                        && request.resource.data.clientId == resource.data.clientId // Cannot change client
                      )
                    );
                    
      // Only admins can delete inquiries
      allow delete: if isAdmin();
    }

    // --- Answers Collection ---
    match /answers/{answerId} {
      // Readers must be logged in and either an admin, the answering doctor, or the client who made the inquiry
      allow read: if isLoggedIn() 
                    && (
                      isAdmin()
                      || (isDoctor() && resource.data.doctorId == request.auth.uid)
                      || (isClient() && get(/databases/$(database)/documents/inquiries/$(resource.data.inquiryId)).data.clientId == request.auth.uid)
                    );
                    
      // Only the assigned doctor can write the answer
      allow create: if isDoctor() 
                    && request.resource.data.doctorId == request.auth.uid
                    && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.doctorId == request.auth.uid;
                    
      // Only admins can update or delete answers
      allow write: if isAdmin();
    }
  }
}
